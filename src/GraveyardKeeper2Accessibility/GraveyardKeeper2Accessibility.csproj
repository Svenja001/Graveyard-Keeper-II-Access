<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Graveyard Keeper II is Unity 6000.3.9f1 on Mono, x64 only. That fixes three things this
        file would otherwise have to decide:
          - netstandard2.1, not GK1's net481. Unity 6 Mono ships netstandard.dll and
            System.Memory.dll in Managed\, and BepInEx 5 loads a netstandard2.1 plugin fine.
          - one output, not three. There is no 32-bit build, so no Tolk and no GOG variant
            (the GK1 repo needed both).
          - references come straight out of the game's Managed\ folder, copied into libs\game\
            at setup time. There is no GameLibs NuGet package for GK2.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>GraveyardKeeper2Accessibility</AssemblyName>
        <RootNamespace>GraveyardKeeper2Accessibility</RootNamespace>
        <Version>0.1.0</Version>
        <Authors>svenja001</Authors>
        <Nullable>disable</Nullable>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <!-- CS0436: our GameKey/etc. never collide, but the game assemblies do define types that
             also exist in netstandard's facade set; silence the type-forwarding noise. -->
        <NoWarn>CS0436;CS1591</NoWarn>
        <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
        <OutputPath>$(GameDir)\BepInEx\plugins\GraveyardKeeper2Accessibility</OutputPath>
        <ReleasesDir>$(MSBuildProjectDirectory)\..\AAA_Releases</ReleasesDir>
    </PropertyGroup>

    <!-- CHANGELOG.md is the source of truth for the version, as in the GK1 repo: the first
         "## X.Y.Z" header wins over the <Version> above, which is only the fallback. -->
    <PropertyGroup Condition="Exists('CHANGELOG.md')">
        <_ChangelogText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\CHANGELOG.md'))</_ChangelogText>
        <_ChangelogVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ChangelogText), '##\s+(\d+\.\d+\.\d+)').Groups[1].Value)</_ChangelogVersion>
        <Version Condition="'$(_ChangelogVersion)' != ''">$(_ChangelogVersion)</Version>
    </PropertyGroup>

    <!-- [BepInPlugin] needs the version as a compile-time constant, so write it into the other
         half of the partial PluginInfo class rather than reading the assembly attribute at runtime. -->
    <Target Name="WritePluginVersion" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_PluginVersionFile>$(IntermediateOutputPath)PluginVersion.g.cs</_PluginVersionFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_PluginVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Lines="namespace GraveyardKeeper2Accessibility%3B;internal static partial class PluginInfo { internal const string Version = &quot;$(Version)&quot;%3B }" />
        <ItemGroup>
            <Compile Include="$(_PluginVersionFile)" />
            <FileWrites Include="$(_PluginVersionFile)" />
        </ItemGroup>
    </Target>

    <!-- Nothing referenced here may be copied next to the plugin: BepInEx scans plugins\ and a
         shipped copy of Assembly-CSharp.dll would shadow the real game assembly. -->
    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Reference Include="BepInEx"><HintPath>..\..\libs\bepinex\BepInEx.dll</HintPath></Reference>
        <Reference Include="0Harmony"><HintPath>..\..\libs\bepinex\0Harmony.dll</HintPath></Reference>
        <Reference Include="BepInEx.Harmony"><HintPath>..\..\libs\bepinex\BepInEx.Harmony.dll</HintPath></Reference>
        <Reference Include="MonoMod.Utils"><HintPath>..\..\libs\bepinex\MonoMod.Utils.dll</HintPath></Reference>
    </ItemGroup>

    <!-- Every DLL that was copied out of the game's Managed\ folder. Globbed rather than listed:
         the set that matters grows with each phase of the plan, and an unused reference is a far
         cheaper mistake than a missing one.

         The path goes straight into Include, which ResolveAssemblyReference accepts as a direct
         file reference. A HintPath would need the assembly's simple name in Include, and getting
         that from a glob means an item transform - at which point each Reference has lost the
         metadata that said where it came from. -->
    <ItemGroup>
        <Reference Include="..\..\libs\game\*.dll">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- Spoken strings, one file per language, loaded at runtime by Loc. -->
    <ItemGroup>
        <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The key list travels with the mod. There is no in-game settings screen for it, so this
         file is the only place a player can find out what the mod's keys are - and a blind player
         who has just extracted the download has this folder open in front of them. -->
    <ItemGroup>
        <None Include="KEYBINDINGS.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Prism speaks through NVDA/JAWS and drives a braille display; without it the mod falls
         back to the Windows SAPI voice. x64 only, which is all GK2 has. MPL-2.0 requires the
         licence text to travel with the binary. -->
    <ItemGroup>
        <None Include="..\..\libs\native\prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\libs\native\prism\LICENSE" Link="prism-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\libs\native\prism\NOTICE" Link="prism-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- Install instructions and the GPL-3.0 text, which has to accompany the distribution. -->
        <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
        <None Include="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
        Release ZIPs, built by "dotnet build -c Release" (release.ps1 does that for you). Two of
        them, as in the GK1 repo:
          - _ModOnly:     rooted at the game's BepInEx\ folder, for players who already have
                          BepInEx 5 installed.
          - _WithBepInEx: rooted at the GAME folder, carrying the unmodified loader from
                          libs\bepinex-dist, so the whole install is one extract. Doorstop's
                          winhttp.dll has to sit beside the .exe, which is why the root differs.
        No GOG 32-bit variant: GK2 is x64 only.

        Staged from an explicit list of what the build produces, not by globbing OutputPath.
        OutputPath is the live plugin folder in the game, so a glob would also pick up anything
        left over in it from older builds.

        The documents are repeated at the ZIP root with a prefix: that root is where a blind
        player lands after extracting, and in the game folder a bare CHANGELOG.md or LICENSE.txt
        would sit next to BepInEx's own changelog.txt and BepInEx-LICENSE.txt.
    -->
    <ItemGroup>
        <RootDoc Include="..\..\README.md" Link="Accessibility-Mod-README.md" />
        <RootDoc Include="KEYBINDINGS.md" Link="Accessibility-Mod-KEYBINDINGS.md" />
        <RootDoc Include="CHANGELOG.md" Link="Accessibility-Mod-CHANGELOG.md" />
        <RootDoc Include="..\..\LICENSE" Link="Accessibility-Mod-LICENSE.txt" />
    </ItemGroup>

    <Target Name="ReleaseZips" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <_Staging>$(TEMP)\GK2_staging\$(MSBuildProjectName)</_Staging>
            <_ModOnlyRoot>$(_Staging)\modonly</_ModOnlyRoot>
            <_FullRoot>$(_Staging)\full</_FullRoot>
            <_BepInExDist>$(MSBuildProjectDirectory)\..\..\libs\bepinex-dist</_BepInExDist>
            <_ZipBase>$(ReleasesDir)\$(MSBuildProjectName)_v$(Version)</_ZipBase>
        </PropertyGroup>

        <!-- Every file the build copies next to the DLL (lang\, prism, docs), each with the path
             it has inside the plugin folder. -->
        <CallTarget Targets="GetCopyToOutputDirectoryItems">
            <Output TaskParameter="TargetOutputs" ItemName="_ShipExtra" />
        </CallTarget>
        <ItemGroup>
            <_ShipFile Include="$(TargetPath)" TargetPath="$(TargetFileName)" />
            <_ShipFile Include="@(_ShipExtra)" />
            <_BepInExFiles Include="$(_BepInExDist)\**\*.*" Exclude="$(_BepInExDist)\README.md" />
        </ItemGroup>

        <RemoveDir Directories="$(_Staging)" />
        <MakeDir Directories="$(ReleasesDir)" />

        <!-- Mod only: <zip>\plugins\GraveyardKeeper2Accessibility\... -->
        <Copy SourceFiles="@(_ShipFile)" DestinationFiles="@(_ShipFile->'$(_ModOnlyRoot)\plugins\$(MSBuildProjectName)\%(TargetPath)')" />
        <Copy SourceFiles="@(RootDoc)" DestinationFiles="@(RootDoc->'$(_ModOnlyRoot)\%(Link)')" />

        <!-- With BepInEx: <zip>\winhttp.dll, <zip>\BepInEx\core\..., <zip>\BepInEx\plugins\... -->
        <Copy SourceFiles="@(_BepInExFiles)" DestinationFiles="@(_BepInExFiles->'$(_FullRoot)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy SourceFiles="@(_ShipFile)" DestinationFiles="@(_ShipFile->'$(_FullRoot)\BepInEx\plugins\$(MSBuildProjectName)\%(TargetPath)')" />
        <Copy SourceFiles="@(RootDoc)" DestinationFiles="@(RootDoc->'$(_FullRoot)\%(Link)')" />

        <!-- Fail loudly rather than shipping a ZIP that quietly cannot load or speak. -->
        <Error Condition="!Exists('$(_ModOnlyRoot)\plugins\$(MSBuildProjectName)\$(TargetFileName)')" Text="Mod-only ZIP is missing the mod DLL." />
        <Error Condition="!Exists('$(_ModOnlyRoot)\plugins\$(MSBuildProjectName)\prism.dll')" Text="Mod-only ZIP is missing prism.dll - is libs\native\prism populated?" />
        <Error Condition="!Exists('$(_ModOnlyRoot)\plugins\$(MSBuildProjectName)\lang\$(MSBuildProjectName).en.json')" Text="Mod-only ZIP is missing the English strings." />
        <Error Condition="!Exists('$(_FullRoot)\winhttp.dll')" Text="BepInEx bundle is missing winhttp.dll - is libs\bepinex-dist populated? See its README." />
        <Error Condition="!Exists('$(_FullRoot)\BepInEx\core\BepInEx.Preloader.dll')" Text="BepInEx bundle is missing BepInEx\core." />

        <ZipDirectory Overwrite="true" SourceDirectory="$(_ModOnlyRoot)" DestinationFile="$(_ZipBase)_ModOnly.zip" />
        <ZipDirectory Overwrite="true" SourceDirectory="$(_FullRoot)" DestinationFile="$(_ZipBase)_WithBepInEx.zip" />
        <RemoveDir Directories="$(_Staging)" />

        <Message Importance="high" Text="Release: $(MSBuildProjectName)_v$(Version)_ModOnly.zip" />
        <Message Importance="high" Text="Release: $(MSBuildProjectName)_v$(Version)_WithBepInEx.zip" />
    </Target>

</Project>
